DATABASE_URL=postgresql://postgres:password@localhost:5432/fortune
PHONE_PEPPER=replace-with-long-random-secret
ADMIN_API_KEY=replace-with-long-random-admin-secret
# Keep false for development. Set true explicitly on Railway for the authorized campaign.
PRIZES_ENABLED=false
# Required when PRIZES_ENABLED=true. Reference of the authorization / approved rules.
AUTHORIZATION_REFERENCE=

# Temporary preview only; ignored whenever real prizes are enabled.
DEMO_UNLIMITED_SPINS=false

# Require real phone possession before spins; never disable for a public campaign.
PHONE_VERIFICATION_REQUIRED=true
RATE_LIMIT_ENABLED=true
REFERRAL_MAX_BONUS_SPINS=20
# Twilio Verify SMS provider; configure secrets in Railway/local environment only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Accounts: distinct permanent keys. Never rotate without a migration plan.
# Generate HMAC key: python -c "import secrets; print(secrets.token_urlsafe(48))"
CPF_HMAC_KEY=
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPF_ENCRYPTION_KEY=
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://YOUR-RAILWAY-DOMAIN
# Compatibility endpoints disabled; do not enable on public deployments.
LEGACY_ACCOUNTS_ENABLED=false
TERMS_VERSION=2026-11-04
PRIVACY_VERSION=2026-11-04
DATA_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_LEGAL_BASIS=
# Optional local encrypted backups; never put this folder under assets/.
MANAGED_BACKUP_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
